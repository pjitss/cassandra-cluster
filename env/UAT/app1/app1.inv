[upload]
mylinserver1 ansible_ssh_host=192.168.0.123 ansible_ssh_user=jitss ansible_ssh_pass='{{ ans_passwd }}' ansible_become_pass='{{ ans_passwd }}' ansible_connection=ansible_ssh_pass

[download]
mywinserver1 ansible_host=192.168.0.127 ansible_ssh_user=jitsswin ansible_ssh_pass='{{ ans_passwd }}' ansible_winrm_transport='ntlm' ansible_winrm_server_cert_validation='ignore'  ansible_connection='winrm' ansible_winrm_read_timeout_sec='600' ansible_ssh_port='6678'

[upload_test]
